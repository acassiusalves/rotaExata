rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== FUNÇÕES DE AUTENTICAÇÃO =====
    function isRetiredFirebaseDriver() {
      let transition = /databases/$(database)/documents/rotaAuthTransition/driver;
      let actor = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(transition) && get(transition).data.get('mode', 'firebase') == 'supabase'
        && (request.auth.uid in get(transition).data.get('driverUids', [])
          || (exists(actor) && (get(actor).data.get('role', '') == 'driver'
            || get(actor).data.get('nativeDriverProvisioningId', '') != '')));
    }

    function rotaStaffUsesNativeAuth() {
      let transition = /databases/$(database)/documents/rotaAuthTransition/staff;
      return exists(transition) && get(transition).data.get('mode', 'firebase') != 'firebase';
    }

    // Sessão válida do Firebase Auth (qualquer conta que não seja entregador aposentado).
    // NÃO prova que a pessoa é da equipe: use só onde a regra confere o dono do próprio
    // documento ou nos contratos do Rota Exata (rotas, avisos, histórico de atividades).
    function isSignedIn() {
      return request.auth != null && !isRetiredFirebaseDriver();
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function profileRole() {
      return getUserData().role == 'manager'
        ? 'gestor'
        : getUserData().role == 'partner'
          ? 'socio'
          : getUserData().role == 'user'
            ? 'usuario'
            : getUserData().role;
    }

    // Equipe interna: perfil em /users (criado só pelo servidor), papel de tela e não desativado.
    // Conta sem perfil, perfil desativado e entregador não passam. O cadastro por e-mail e senha
    // pode ser reaberto no console por engano, então a sessão sozinha nunca libera dado.
    function isAuthed() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profileRole() in ['admin', 'gestor', 'socio', 'vendedor', 'estoquista', 'financeiro', 'marketing', 'usuario']
        && getUserData().get('active', true) != false;
    }

    function canonicalRole() {
      return !isAuthed() ? null : profileRole();
    }

    function hasRole(roles) {
      return isAuthed() && canonicalRole() in roles;
    }

    function isAppAdmin() {
      return hasRole(['admin', 'gestor', 'socio']);
    }

    // Mesmo critério de isAuthed(); o nome fica para as regras que já o usam.
    function isInternalUser() {
      return isAuthed();
    }

    function isAdmin() {
      return isAuthed() && getUserData().role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNativeDriverUuid(value) {
      return value is string && value.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
    }

    function nativeDispatchAllowed(driverId) {
      return !isNativeDriverUuid(driverId) || nativeDispatchProfileAllowed(driverId);
    }

    function nativeDispatchProfileAllowed(driverId) {
      let user = /databases/$(database)/documents/users/$(driverId);
      return exists(user) && get(user).data.get('role', '') == 'driver'
        && (get(user).data.get('nativeDriverProvisioningId', '') == ''
          || (get(user).data.get('nativeDriverReady', false)
            && get(user).data.get('nativeDriverDispatchEnabled', false)));
    }

    // ===== USERS COLLECTION =====
    match /users/{userId} {
      function nativeProjectionFields() {
        return ['nativeDriverProvisioningId','nativeDriverReady','nativeDriverDispatchEnabled','nativeDriverDispatchFence','nativeStaffProvisioningId'];
      }
      function protectedNativeProfile() {
        return resource.data.get('nativeDriverProvisioningId', '') != '' ||
          resource.data.get('nativeStaffProvisioningId', '') != '';
      }
      function nativeProjectionUpdateAllowed() {
        let fields = request.resource.data.diff(resource.data).affectedKeys();
        return !fields.hasAny(nativeProjectionFields())
          && (!isNativeDriverUuid(userId) || request.resource.data.get('role', '') != 'driver'
            || resource.data.get('role', '') == 'driver')
          && (!protectedNativeProfile()
            || !fields.hasAny(['role','active','disabled','permissions','forceLogoutAt','fcmSessionBindingId']));
      }
      allow read: if isOwner(userId) || isAppAdmin();
      allow update: if nativeProjectionUpdateAllowed() && (isAppAdmin() || (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','active','disabled','permissions','forceLogoutAt','fcmSessionBindingId'])));
      allow create: if isAppAdmin() && !request.resource.data.keys().hasAny(nativeProjectionFields())
        && (!isNativeDriverUuid(userId) || request.resource.data.get('role', '') != 'driver');
      allow delete: if isAppAdmin() && !protectedNativeProfile();
      // Permitir list para usuários autenticados (vendedores precisam ver lista de vendedores para criar pedidos)
      allow list: if isAuthed();
    }

    // ===== COURIERS COLLECTION =====
    match /couriers/{courierId} {
      allow read, update: if isOwner(courierId);
      allow create: if isAppAdmin();
    }

    match /couriers/{courierId}/tokens/{tokenId} {
      allow read, write: if isOwner(courierId);
    }

    // ===== ROUTES COLLECTION =====
    match /routes/{routeId} {
      // Função para verificar se usuário tem acesso a rotas (inclui financeiro para faturamento)
      function hasRoutesAccess() {
        return isAuthed() && getUserData().role in ['admin', 'gestor', 'socio', 'financeiro'];
      }

      // Usuários com acesso podem criar, deletar, ler, listar e atualizar
      allow delete, read, list: if hasRoutesAccess();
      allow create: if hasRoutesAccess() && nativeDispatchAllowed(request.resource.data.get('driverId', null));
      allow update: if hasRoutesAccess() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['earningsSourceStart','earningsSourceCompletion'])
        && ((resource.data.get('driverId', null) == request.resource.data.get('driverId', null)
          && (resource.data.get('status', '') == request.resource.data.get('status', '')
            || !(request.resource.data.get('status', '') in ['dispatched','in_progress'])))
          || nativeDispatchAllowed(request.resource.data.get('driverId', null)));
      // Clientes legados podem transmitir a posição. A PWA canônica usa a API.
      allow read: if isSignedIn() && resource.data.driverId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.driverId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentLocation','lastUpdated','actualPath']);
    }

    // This public marker contains protocol/version only, never credentials or user data.
    // Compat remains the published legacy policy while the preparatory Rules propagate.
    function r1LegacyWritesAllowed() {
      let marker = /databases/$(database)/documents/platformReleaseStatus/r1;
      return exists(marker) && get(marker).data.get('protocolVersion', 0) == 1
        && get(marker).data.get('mode', '') == 'compat';
    }
    match /platformReleaseStatus/{releaseId} {
      allow get: if releaseId == 'r1';
      allow list, write: if false;
    }

    // ===== COUNTERS COLLECTION (para geração de códigos sequenciais) =====
    // Vendedores precisam acessar para gerar números de pedidos
    match /counters/{counterId} {
      allow read: if isAuthed();
      // Commercial numbers are allocated with their native document and receipt.
      allow write: if isAuthed() && (r1LegacyWritesAllowed() || !(counterId in [
        'orders_pedido', 'orders_troca', 'orders_retorno_troca',
        'orders_venda_balcao', 'pedidos_compra_counter', 'entradas_compra_counter', 'vendas'
      ]));
    }

    // ===== SETTINGS COLLECTION =====
    match /settings/{settingId} {
      // Leitura só para a equipe. Duas exceções, por contrato do Rota Exata, que lê estes
      // documentos pelo navegador sem sessão do Firebase: a origem padrão das rotas e a
      // validação de distância da entrega. Nenhum dos dois guarda segredo.
      // A chave do Google Maps (settings/googleMaps) é só do servidor, via Admin SDK.
      allow read: if settingId in ['defaultOrigin', 'general']
        || (settingId != 'googleMaps' && isAuthed());
      allow write: if settingId != 'googleMaps' && isAppAdmin()
        && (settingId != 'permissions' || !rotaStaffUsesNativeAuth());
    }

    // ===== CONFIGURAÇÕES COLLECTION =====
    match /configuracoes/{configId} {
      // Leitura permitida para qualquer usuário autenticado (estoquistas precisam ler etiqueta)
      allow read: if isAuthed();
      // Escrita apenas para admin, gestor e socio (exceto etiqueta que permite estoquista)
      allow write: if hasRole(['admin', 'gestor', 'socio', 'estoquista']);
    }

    // ===== LOCATION UPDATE REQUESTS =====
    match /locationUpdateRequests/{driverId} {
      allow create, update: if isAppAdmin() && !rotaStaffUsesNativeAuth();
      allow read, delete: if isSignedIn() && driverId == request.auth.uid;
    }

    // ===== PRODUCTS COLLECTION =====
    // O documento traz custo, atacado, varejo, promoção e fornecedor: só a equipe interna lê.
    // As páginas públicas (/c/[slug] e /catalogo-whatsapp) leem pelo servidor (Admin SDK),
    // que devolve só os campos do tipo de preço do catálogo.
    match /products/{productId} {
      allow read: if isInternalUser();
      allow create, update: if isInternalUser() && r1LegacyWritesAllowed();
      allow delete: if false;
    }

    // ===== STOCK COLLECTION =====
    match /stock/{stockId} {
      allow read: if isAuthed();
      allow write: if isAuthed() && r1LegacyWritesAllowed();
    }

    // ===== SALES COLLECTION =====
    match /sales/{saleId} {
      allow read: if isAuthed();
      allow write: if isAuthed() && r1LegacyWritesAllowed();
    }

    // ===== PURCHASES COLLECTION =====
    match /purchases/{purchaseId} {
      allow read: if isAuthed();
      allow write: if isAuthed() && r1LegacyWritesAllowed();
    }

    // ===== SUPPLIERS COLLECTION =====
    match /suppliers/{supplierId} {
      allow read, write: if isAuthed();
    }

    // ===== VARIÁVEIS COLLECTION =====
    match /variaveis/{variavelId} {
      // Permitir leitura para qualquer usuário autenticado (vendedores precisam ver formas de pagamento, etc)
      allow read, list: if isAuthed();
      // Apenas admins podem criar, atualizar e deletar
      allow write: if isAppAdmin();
    }

    // ===== INTEGRAÇÕES GLOBAIS (somente servidor) =====
    // Os documentos guardam segredos e tokens (Bling, Google Drive, Google Contatos, Gemini).
    // Leitura e escrita só pelo servidor (Admin SDK), que ignora estas regras: a tela /conexoes,
    // os callbacks de OAuth e as emissões no Bling passam por rotas de API.
    match /integrations/{integrationId} {
      allow read, write: if false;
      match /accounts/{accountId} {
        allow read, write: if false;
      }
    }

    // ===== CLIENTES COLLECTION =====
    match /clientes/{clienteId} {
      allow read, write: if isAuthed();
    }

    // ===== MOVIMENTAÇÕES COLLECTION =====
    match /movimentacoes/{movimentacaoId} {
      allow read, write: if isAuthed();
    }

    // ===== MOVIMENTAÇÕES DE ESTOQUE COLLECTION =====
    match /movimentacoesEstoque/{movimentacaoId} {
      // Qualquer usuário autenticado pode ler e criar movimentações
      allow read, create: if isAuthed();
      // Apenas admins podem atualizar ou deletar
      allow update, delete: if isAppAdmin();
    }

    // ===== PRODUTOS COLLECTION (LEGADO — somente servidor) =====
    // Auditada em 28/08/2026: 0 documentos em produção. Nenhum código do navegador lê ou grava
    // esta coleção. O único leitor é o plano B do catálogo público em
    // src/lib/server/catalogos/public-access.ts (Admin SDK, ignora estas regras).
    match /produtos/{produtoId} {
      allow read, write: if false;
    }

    // ===== FORNECEDORES COLLECTION =====
    match /fornecedores/{fornecedorId} {
      allow read, write: if isAuthed();
    }

    // ===== VENDAS COLLECTION =====
    match /vendas/{vendaId} {
      allow read: if isAuthed();
      allow write: if isAuthed() && r1LegacyWritesAllowed();
    }

    // ===== PEDIDOS COLLECTION =====
    match /pedidos/{pedidoId} {
      allow read: if isAuthed();
      allow write: if isAuthed() && r1LegacyWritesAllowed();
    }

    // ===== ORDERS COLLECTION (English alias for pedidos) =====
    match /orders/{orderId} {
      function temFinanceiroV2(data) {
        return data.get('retornoFinanceiro', {}).get('versao', 0) == 2;
      }
      function preservaFinanceiroV2() {
        return request.resource.data.get('retornoFinanceiro', {}) == resource.data.get('retornoFinanceiro', {})
          // Custo, comissão e taxa do cartão congelados: em pedido V2 só o servidor grava.
          && request.resource.data.get('resultadoFaturamento', null) == resource.data.get('resultadoFaturamento', null)
          && request.resource.data.get('items', []) == resource.data.get('items', [])
          && request.resource.data.get('itens', []) == resource.data.get('itens', [])
          && request.resource.data.get('itensDevolvidos', []) == resource.data.get('itensDevolvidos', [])
          && request.resource.data.get('shipping', {}).get('deliveryValue', 0) == resource.data.get('shipping', {}).get('deliveryValue', 0)
          && !request.resource.data.get('billing', {}).diff(resource.data.get('billing', {})).affectedKeys().hasAny([
            'grossValue', 'subtotal', 'finalValue', 'discountValue', 'discounts', 'discount',
            'additions', 'credit', 'delivery', 'custoFrete', 'experimentacaoTotal',
            'valorRecebido', 'descontoFaturamentoValor', 'descontoFaturamentoAplicado', 'acaoAplicada'
          ]);
      }
      // Only the remaining delivery/route/cash SDK producers may update metadata.
      function legacyMetadataOnly() {
        let beforeShipping = resource.data.get('shipping', {});
        let afterShipping = request.resource.data.get('shipping', {});
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'caixaRota', 'fechamentoCaixa', 'updatedAt', 'dataPedido', 'shipping',
          'reentrega', 'tentativasEntrega', 'historicoAlteracoes', 'deliveryBackup',
          'logisticsStatus', 'rotaExataRouteId', 'rotaExataRouteCode',
          'rotaExataServiceId', 'rotaExataServiceCode'
        ]) && (beforeShipping == afterShipping
          || (beforeShipping is map && afterShipping is map
            && afterShipping.diff(beforeShipping).affectedKeys()
              .hasOnly(['deliveryDate', 'deliveryTimeStart', 'deliveryTimeEnd'])));
      }
      allow read: if isAuthed();
      allow create: if isAuthed() && r1LegacyWritesAllowed() && !temFinanceiroV2(request.resource.data)
        && !request.resource.data.keys().hasAny(['retornoPosFaturamento']);
      allow update: if isAuthed() && (legacyMetadataOnly()
        || (r1LegacyWritesAllowed() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['retornoPosFaturamento'])
          && ((!temFinanceiroV2(resource.data) && !temFinanceiroV2(request.resource.data)) || preservaFinanceiroV2())));
      allow delete: if isAuthed() && r1LegacyWritesAllowed() && !temFinanceiroV2(resource.data);
    }

    // Immutable proofs and idempotent commands are written only through Admin transactions.
    match /retorno_ajustes_financeiros/{id} {
      allow read: if isAuthed();
      allow write: if false;
    }
    match /faturamento_comandos/{id} {
      allow read, write: if false;
    }

    // ===== CLIENTS COLLECTION (English alias for clientes) =====
    match /clients/{clientId} {
      allow read, write: if isAuthed();
    }

    // ===== CATÁLOGOS COLLECTION (somente servidor) =====
    // O documento guarda cliente, lista de produtos, tipo de preço e a senha do catálogo privado.
    // Gestão: src/lib/server/catalogos/commands.ts e read.ts. Página pública:
    // src/lib/server/catalogos/public-access.ts. Tudo com Admin SDK, que ignora estas regras.
    match /catalogos/{catalogoId} {
      allow read, write: if false;
    }

    // ===== MÉTRICAS DO CATÁLOGO PÚBLICO (somente servidor) =====
    // Interações, interesses, curtidas, visitas e presença são gravados pelo servidor (Admin SDK,
    // que ignora estas regras): src/lib/server/catalogos/public-events.ts, pelas rotas
    // /api/catalogo/[slug]/events e /api/catalogo/[slug]/identity. Nenhum código do navegador
    // grava aqui. Com a gravação aberta, qualquer pessoa inflava as métricas, escondia visitantes
    // reais e gerava custo de gravação.
    // A leitura também é só do servidor (insights.ts, presence.ts e public-state.ts, pelas rotas
    // /api/catalogos/insights, /analytics e /presence): os registros trazem dados de visitantes e
    // de interessados, e o cadastro por e-mail e senha está aberto no projeto.
    match /catalogo_interacoes/{interacaoId} {
      allow read, write: if false;
    }

    match /catalogo_interesses/{interesseId} {
      allow read, write: if false;
    }

    match /catalogo_likes/{likeId} {
      allow read, write: if false;
    }

    match /catalogo_analytics/{analyticsId} {
      allow read, write: if false;
    }

    match /catalogo_presenca/{presencaId} {
      allow read, write: if false;
    }

    // ===== AUDIT LOGS =====
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthed();
      allow update, delete: if false;
    }

    // ===== WORKFLOW - ESTADOS =====
    match /estados_workflow/{estadoId} {
      // Leitura liberada a qualquer autenticado (motor de transições, dropdowns).
      allow read: if isAuthed();
      // create autenticado por causa do fallback de cold-start em src/app/pedidos/novo/page.tsx (~2749), que cria o estado inicial 'Reserva para entrega' rodando como vendedor.
      allow create: if isAuthed();
      // Edição/remoção da config só por admin/gestor/socio (página /transicoes).
      allow update, delete: if isAppAdmin();
    }

    // ===== WORKFLOW - TRANSIÇÕES =====
    match /transicoes_workflow/{transicaoId} {
      // Leitura a qualquer autenticado; escrita da config só por admin/gestor/socio.
      allow read: if isAuthed();
      allow write: if isAppAdmin();
    }

    // ===== WORKFLOW - SITUAÇÕES (NOVA COLEÇÃO) =====
    match /situacoes/{situacaoId} {
      // Leitura a qualquer autenticado; escrita da config só por admin/gestor/socio.
      allow read: if isAuthed();
      allow write: if isAppAdmin();
    }

    // ===== HISTÓRICO DE PRODUTOS =====
    match /historico_produtos/{historicoId} {
      allow read, list: if isAuthed();
      allow create: if false;
      allow update, delete: if false;
    }

    // ===== HISTÓRICO DE ESTOQUE =====
    match /historico_estoque/{historicoId} {
      allow read: if isAuthed();
      allow create: if false;
      allow update, delete: if false;
    }

    // ===== HISTÓRICO DE MOVIMENTAÇÕES DE PEDIDOS =====
    match /historico_movimentacoes/{movimentacaoId} {
      allow read: if isAuthed();
      allow create: if false;
      allow update, delete: if false;
    }

    // ===== HISTÓRICO DE CONFIGURAÇÕES =====
    match /historico_configuracoes/{historicoId} {
      // Apenas equipe interna pode consultar
      allow read, list: if hasRole(['admin', 'gestor', 'socio']);
      // Escrita apenas pelo servidor/Admin SDK
      allow create: if false;
      // Histórico é imutável
      allow update, delete: if false;
    }

    // ===== PICKING REGISTROS =====
    match /picking_registros/{registroId} {
      // Qualquer usuário autenticado pode ler e criar
      allow read, create: if isAuthed();
      // Apenas admins podem atualizar ou deletar
      allow update, delete: if isAppAdmin();
    }

    // ===== LEDGERS E REGISTROS DE RETORNO (somente servidor) =====
    match /retorno_operacoes/{operacaoId} {
      allow read: if isAuthed();
      allow create, update, delete: if false;
    }

    match /retorno_pos_faturamento_operacoes/{operacaoId} {
      allow read, write: if false; // Somente a API autenticada; ledger imutável.
    }

    match /retorno_estornos/{estornoId} {
      allow read: if isAuthed();
      allow create, update, delete: if false;
    }

    match /retorno_registros/{registroId} {
      allow read: if isAuthed();
      allow create, update, delete: if false;
    }

    // ===== CRÉDITOS DE CLIENTES =====
    match /creditos_clientes/{creditoId} {
      function origemSemFinanceiroV2(data) {
        return data.get('pedidoOrigemId', '') == '' ||
          get(/databases/$(database)/documents/orders/$(data.pedidoOrigemId)).data.get('retornoFinanceiro', {}).get('versao', 0) != 2;
      }
      allow read: if isAuthed();
      allow create: if isAuthed() && r1LegacyWritesAllowed() && origemSemFinanceiroV2(request.resource.data);
      function consumoValido() {
        let antes=resource.data;
        let depois=request.resource.data;
        return antes.status == 'ativo'
          && depois.diff(antes).affectedKeys().hasOnly(['valor','valorUtilizado','status','dataUtilizacao','pedidoUtilizacaoId','pedidoUtilizacaoNumero','updatedAt'])
          && depois.valor >= 0 && depois.valor < antes.valor
          && depois.valorUtilizado > antes.get('valorUtilizado',0)
          && math.abs((depois.valor + depois.valorUtilizado) - (antes.valor + antes.get('valorUtilizado',0))) < 0.000001
          && depois.status == (depois.valor == 0 ? 'utilizado' : 'ativo')
          && depois.pedidoUtilizacaoId is string && depois.pedidoUtilizacaoId != '';
      }
      allow update: if isAuthed() && r1LegacyWritesAllowed() && ((origemSemFinanceiroV2(resource.data) && origemSemFinanceiroV2(request.resource.data)) || consumoValido());
      allow delete: if isAppAdmin() && r1LegacyWritesAllowed() && origemSemFinanceiroV2(resource.data);
    }

    // Purchase documents and physical balances share one native commit.
    match /pedidos_compra/{pedidoId} {
      allow read, list: if isAuthed();
      allow create: if isAuthed() && r1LegacyWritesAllowed();
      allow update, delete: if isAppAdmin() && r1LegacyWritesAllowed();
    }
    match /entradas_compra/{entradaId} {
      allow read, list: if isAuthed();
      allow create: if isAuthed() && r1LegacyWritesAllowed();
      allow update, delete: if isAppAdmin() && r1LegacyWritesAllowed();
    }

    // ===== LEMBRETES COLLECTION =====
    match /lembretes/{lembreteId} {
      // Qualquer usuário autenticado pode criar e atualizar lembretes
      allow create, update: if isAuthed();
      // Vendedores podem ler apenas seus próprios lembretes
      // Admins e gestores podem ler todos
      allow read: if isAuthed() && (
        isAppAdmin() ||
        resource.data.vendedorId == request.auth.uid
      );
      // Listar lembretes com filtro por vendedor
      allow list: if isAuthed();
      // Apenas admins e gestores podem deletar
      allow delete: if isAppAdmin();
    }

    // ===== NOTIFICAÇÕES COLLECTION =====
    match /notificacoes/{notificacaoId} {
      // Sistema pode criar notificações (via Cloud Functions ou direto no código)
      allow create: if isAuthed();
      // Usuários só podem ler suas próprias notificações
      allow read: if isAuthed() && resource.data.usuarioId == request.auth.uid;
      // Usuários podem atualizar (marcar como lida) suas próprias notificações
      allow update: if isAuthed() && resource.data.usuarioId == request.auth.uid;
      // Usuários podem deletar suas próprias notificações
      allow delete: if isAuthed() && resource.data.usuarioId == request.auth.uid;
      // Permitir listar notificações do próprio usuário
      allow list: if isAuthed();
    }

    // ===== EVOLUTION WHATSAPP - INSTANCES =====
    match /evo_instances/{instanceId} {
      // Qualquer usuário autenticado pode ler e listar
      allow read, list: if isAuthed();
      // Qualquer usuário autenticado pode criar e atualizar
      allow create, update: if isAuthed();
      // Apenas admins podem deletar
      allow delete: if isAppAdmin();
    }

    // ===== EVOLUTION WHATSAPP - LEADS =====
    match /evo_leads/{leadId} {
      // Qualquer usuário autenticado pode ler e listar
      allow read, list: if isAuthed();
      // Qualquer usuário autenticado pode criar e atualizar
      allow create, update: if isAuthed();
      // Apenas admins podem deletar
      allow delete: if isAppAdmin();
    }

    // ===== EVOLUTION WHATSAPP - CONVERSATIONS =====
    match /evo_conversations/{conversationId} {
      // Qualquer usuário autenticado pode ler e listar
      allow read, list: if isAuthed();
      // Qualquer usuário autenticado pode criar e atualizar
      allow create, update: if isAuthed();
      // Apenas admins podem deletar
      allow delete: if isAppAdmin();
    }

    // ===== EVOLUTION WHATSAPP - MESSAGES =====
    match /evo_messages/{messageId} {
      // Qualquer usuário autenticado pode ler e listar
      allow read, list: if isAuthed();
      // Qualquer usuário autenticado pode criar
      allow create: if isAuthed();
      // Apenas admins podem atualizar e deletar
      allow update, delete: if isAppAdmin();
    }

    // ===== EVOLUTION WHATSAPP - SETTINGS =====
    match /evo_settings/{settingId} {
      // Qualquer usuário autenticado pode ler
      allow read: if isAuthed();
      // Apenas admins podem escrever
      allow write: if isAppAdmin();
    }

    // ===== EVOLUTION WHATSAPP - QUICK REPLIES =====
    match /evo_quick_replies/{replyId} {
      // Qualquer usuário autenticado pode ler e listar
      allow read, list: if isAuthed();
      // Qualquer usuário autenticado pode criar e atualizar
      allow create, update: if isAuthed();
      // Apenas admins podem deletar
      allow delete: if isAppAdmin();
    }

    // ===== EVOLUTION WHATSAPP - USER PREFERENCES (leads fixados, etc) =====
    match /evo_user_preferences/{userId} {
      // Usuário pode ler e escrever apenas suas próprias preferências
      allow read, write: if isOwner(userId);
    }

    // ===== PHOTO PACKS (Pacotes de Fotos para WhatsApp) =====
    match /photoPacks/{packId} {
      // Qualquer usuário autenticado pode ler e listar
      allow read, list: if isAuthed();
      // Qualquer usuário autenticado pode criar e atualizar
      allow create, update: if isAuthed();
      // Apenas admins podem deletar
      allow delete: if isAppAdmin();
    }

    // ===== TAGS COLLECTION =====
    match /tags/{tagId} {
      // Qualquer usuário autenticado pode ler e listar
      allow read, list: if isAuthed();
      // Qualquer usuário autenticado pode criar e atualizar
      allow create, update: if isAuthed();
      // Apenas admins podem deletar
      allow delete: if isAppAdmin();
    }

    // ===== TAGS DE CATÁLOGO COLLECTION =====
    match /tags_catalogo/{tagId} {
      // Qualquer usuário autenticado pode ler e listar
      allow read, list: if isAuthed();
      // Qualquer usuário autenticado pode criar e atualizar
      allow create, update: if isAuthed();
      // Apenas admins podem deletar
      allow delete: if isAppAdmin();
    }

    // ===== WHATSAPP NUMBERS (Números salvos para catálogos) =====
    match /whatsapp_numbers/{numberId} {
      allow read, list: if isAuthed();
      allow create, update: if isAuthed();
      allow delete: if isAuthed();
    }

    // ===== SERVICES COLLECTION (Rota Exata - Serviços de entrega) =====
    match /services/{serviceId} {
      allow read, list: if isAuthed();
      allow create, update: if isAuthed();
      allow delete: if isAppAdmin();
    }

    // ===== IMPORT JOBS COLLECTION (Importação em segundo plano) =====
    match /import_jobs/{jobId} {
      // Qualquer usuário autenticado pode ler e listar jobs
      allow read, list: if isAuthed();
      // Qualquer usuário autenticado pode criar jobs
      allow create: if isAuthed();
      // Qualquer usuário autenticado pode atualizar (para cancelamento)
      allow update: if isAuthed();
      // Apenas admins podem deletar
      allow delete: if isAppAdmin();

      // Subcoleção de dados do job
      match /data/{chunkId} {
        allow read, write: if isAuthed();
      }
    }

    // ===== CAIXA ROTA FECHAMENTOS =====
    match /caixa_rota_fechamentos/{fechamentoId} {
      // Qualquer usuário autenticado pode ler e listar
      allow read, list: if isAuthed();
      // Qualquer usuário autenticado pode criar e atualizar
      allow create, update: if isAuthed();
      // Apenas admins podem deletar
      allow delete: if isAppAdmin();
    }

    // ===== FECHAMENTOS DE CAIXA =====
    match /fechamentos_caixa/{fechamentoId} {
      // Qualquer usuário autenticado pode ler e listar fechamentos
      allow read, list: if isAuthed();
      // Qualquer usuário autenticado pode criar fechamentos
      allow create: if isAuthed();
      // Apenas o criador ou admins podem atualizar
      allow update: if isAuthed() && (
        resource.data.usuarioAbertura == request.auth.uid ||
        isAppAdmin()
      );
      // Apenas admins podem deletar
      allow delete: if isAppAdmin();
    }

    // ===== PLANILHAS FINANCEIRAS =====
    match /financial_spreadsheets/{spreadsheetId} {
      // Função para verificar se usuário tem acesso financeiro
      function hasFinancialAccess() {
        return isAuthed() && getUserData().role in ['admin', 'gestor', 'socio', 'financeiro'];
      }

      // Usuários com acesso financeiro podem ler e listar
      allow read, list: if hasFinancialAccess();
      // Usuários com acesso financeiro podem criar
      allow create: if hasFinancialAccess();
      // Usuários com acesso financeiro podem atualizar
      allow update: if hasFinancialAccess();
      // Apenas admin e socio podem deletar
      allow delete: if isAuthed() && getUserData().role in ['admin', 'socio'];
    }

    // ===== DADOS DE PLANILHAS FINANCEIRAS (CHUNKS) =====
    match /financial_spreadsheet_data/{chunkId} {
      // Função para verificar se usuário tem acesso financeiro
      function hasFinancialAccess() {
        return isAuthed() && getUserData().role in ['admin', 'gestor', 'socio', 'financeiro'];
      }

      // Usuários com acesso financeiro podem ler e listar
      allow read, list: if hasFinancialAccess();
      // Usuários com acesso financeiro podem criar chunks
      allow create: if hasFinancialAccess();
      // Apenas admin pode atualizar chunks
      allow update: if isAdmin();
      // Apenas admin e socio podem deletar chunks
      allow delete: if isAuthed() && getUserData().role in ['admin', 'socio'];
    }

    // ===== BALANÇO DE ESTOQUE =====
    match /balancos/{balancoId} {
      // Função para verificar se usuário tem acesso ao estoque
      function hasEstoqueAccess() {
        return isAuthed() && getUserData().role in ['admin', 'gestor', 'socio', 'estoquista'];
      }

      function noNativeApplication(data) {
        return !data.keys().hasAny(['application']);
      }
      function legacyStatusUpdate() {
        let before = resource.data.get('status', '');
        let after = request.resource.data.get('status', '');
        return before == after || (before == 'em_andamento' && after in ['finalizado','cancelado'])
          || (before == 'finalizado' && after == 'cancelado');
      }
      allow read, list: if hasEstoqueAccess();
      allow create: if hasEstoqueAccess() && noNativeApplication(request.resource.data)
        && (r1LegacyWritesAllowed() || !request.resource.data.keys().hasAny(['aplicadoEm','aplicadoPor']));
      allow update: if hasEstoqueAccess() && noNativeApplication(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['application'])
        && (r1LegacyWritesAllowed() || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['aplicadoEm','aplicadoPor']) && legacyStatusUpdate()));
      allow delete: if hasRole(['admin','socio']) && noNativeApplication(resource.data);
      match /itens/{itemId} {
        function parentFree() {
          return noNativeApplication(get(/databases/$(database)/documents/balancos/$(balancoId)).data);
        }
        allow read, list: if hasEstoqueAccess();
        allow create, update: if hasEstoqueAccess() && parentFree()
          && (r1LegacyWritesAllowed() || get(/databases/$(database)/documents/balancos/$(balancoId)).data.get('status', '') == 'em_andamento');
        allow delete: if hasEstoqueAccess() && parentFree();
      }
    }

    // ===== HISTÓRICO DE BALANÇO =====
    match /historico_balancos/{historicoId} {
      // Qualquer usuário com acesso ao estoque pode ler
      allow read, list: if isAuthed() && getUserData().role in ['admin', 'gestor', 'socio', 'estoquista'];
      // Apenas admins/gestores podem criar (ao aplicar balanço), sempre em nome próprio.
      // As linhas por produto vão em partes (tipoRegistro 'parte_alteracoes_balanco') gravadas
      // ANTES do resumo; depois que o resumo existe, ninguém anexa partes a ele.
      allow create: if isAuthed()
        && getUserData().role in ['admin', 'gestor', 'socio']
        && request.resource.data.get('aplicadoPor', '') == request.auth.uid
        && (request.resource.data.get('tipoRegistro', '') != 'parte_alteracoes_balanco'
          || (request.resource.data.get('historicoId', '') is string
            && request.resource.data.historicoId.size() > 0
            && request.resource.data.historicoId != historicoId
            && !exists(/databases/$(database)/documents/historico_balancos/$(request.resource.data.historicoId))));
      // Ninguém pode atualizar ou deletar histórico
      allow update, delete: if false;
    }

    // ===== METAS DE VENDEDORES (Relatórios) =====
    match /metas-vendedores/{periodoId} {
      allow read, list: if isAuthed();
      allow create, update: if isAppAdmin();
      allow delete: if isAppAdmin();
    }

    // ===== CONFIGURAÇÕES DE COMISSÃO (Relatórios) =====
    match /comissao-configuracoes/{configId} {
      allow read, list: if isAuthed();
      allow create, update, delete: if isAuthed() && getUserData().role in ['admin', 'gestor', 'socio', 'financeiro'];
    }

    // Taxas do cartão (Resultado em /faturamento): lidas no faturamento e na prévia da tela.
    match /taxas-cartao-configuracoes/{configId} {
      allow read, list: if isAuthed();
      allow create, update, delete: if isAuthed() && getUserData().role in ['admin', 'gestor', 'socio', 'financeiro'];
    }

    // ===== FATURAMENTOS COLLECTION =====
    match /faturamentos/{faturamentoId} {
      // Função para verificar se usuário tem acesso financeiro
      function hasFinancialAccess() {
        return isAuthed() && getUserData().role in ['admin', 'gestor', 'socio', 'financeiro'];
      }

      function pedidoSemFinanceiroV2(data) {
        return data.get('pedidoId', '') != ''
          && get(/databases/$(database)/documents/orders/$(data.pedidoId)).data.get('retornoFinanceiro', {}).get('versao', 0) != 2;
      }
      // Usuários com acesso financeiro podem ler e listar faturamentos
      allow read, list: if hasFinancialAccess();
      // Sistema pode criar faturamentos (qualquer usuário autenticado ao faturar pedido)
      allow create: if isAuthed() && r1LegacyWritesAllowed() && pedidoSemFinanceiroV2(request.resource.data);
      // Apenas usuários com permissão financeira podem atualizar (para edições)
      allow update: if hasFinancialAccess() && r1LegacyWritesAllowed() && pedidoSemFinanceiroV2(resource.data) && pedidoSemFinanceiroV2(request.resource.data);
      // Apenas admin e socio podem deletar
      allow delete: if isAuthed() && r1LegacyWritesAllowed() && getUserData().role in ['admin', 'socio'] && pedidoSemFinanceiroV2(resource.data);
    }

    // RotaExata contracts added to the shared published baseline (2026-10-16).
    // Before deploying, re-read the shared release and review concurrent changes.
    match /notifications/{notificationId} {
      function ownsNotification() {
        return isSignedIn() && resource.data.driverId == request.auth.uid;
      }
      function reservesStaffAuthors(keys) {
        return !keys.hasAny(['staffScopeId', 'staffAuthorId', 'staffAuthorName', 'staffNotificationCommandId', 'staffPushStatus']);
      }
      allow read: if isAppAdmin() || ownsNotification();
      allow create: if reservesStaffAuthors(request.resource.data.keys())
        && ((isAppAdmin() && !rotaStaffUsesNativeAuth()) || (isSignedIn() && request.resource.data.driverId == request.auth.uid));
      allow update: if reservesStaffAuthors(request.resource.data.diff(resource.data).affectedKeys())
        && ((isAppAdmin() && !rotaStaffUsesNativeAuth()) || (ownsNotification()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opened', 'openedAt', 'read'])));
      allow delete: if isAppAdmin() && !rotaStaffUsesNativeAuth();
    }

    match /routeChangeNotifications/{routeId} {
      function ownsRouteChange() {
        return isSignedIn() && resource.data.driverId == request.auth.uid
          && get(/databases/$(database)/documents/routes/$(routeId)).data.driverId == request.auth.uid;
      }
      allow read: if isAppAdmin() || ownsRouteChange();
      allow create, delete: if isAppAdmin();
      allow update: if isAppAdmin() || (ownsRouteChange()
        && request.resource.data.acknowledged == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged', 'acknowledgedAt']));
    }

    match /users/{userId}/settings/preferences {
      allow read: if isOwner(userId) || isAppAdmin();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['notifications', 'darkMode', 'autoNavigation', 'keepScreenOn', 'pushRevision'])
        && request.resource.data.get('pushRevision', 0) is int
        && request.resource.data.get('pushRevision', 0) >= 0
        && request.resource.data.get('notifications', false) is bool
        && request.resource.data.get('darkMode', false) is bool
        && request.resource.data.get('autoNavigation', false) is bool
        && request.resource.data.get('keepScreenOn', true) is bool;
    }

    match /activity_log/{logId} {
      // Contrato do Rota Exata: fica na sessão simples até o histórico de lá passar pelo servidor.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !logId.matches('^staff-.*')
        && !request.resource.data.keys().hasAny(['canonicalUserId','staffAuditVersion','staffScopeId','staffAuditOperationId']);
      allow update, delete: if false;
    }
  }
}
